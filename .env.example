PORT=5000
SITE_URL=https://www.ashoktex.in

MONGODB_USERNAME=your-mongodb-username
MONGODB_PASSWORD=your-mongodb-password
MONGODB_URI=mongodb+srv://your-mongodb-username:your-mongodb-password@cluster.example.mongodb.net
MONGODB_DATABASE=ashoktex_prod
MONGODB_POOL_MAX=10
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
CORS_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=ashok-tex

# JWT secret used to sign admin session tokens — set a strong random value in production
JWT_SECRET=your-long-random-secret-min-32-chars

# Default admin account (created on first run if it doesn't already exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_USERNAME_2=arvinth
ADMIN_PASSWORD_2=change-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com
VITE_API_BASE_URL=