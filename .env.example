PORT=5000
NODE_ENV=development
SITE_URL=https://www.ashoktex.in

# This uses the Supabase Database password, not SUPABASE_SECRET_KEY.
# URL-encode special password characters before placing them here.
DATABASE_URL=postgresql://postgres.[project-id]:your-password@aws-[region].pooler.supabase.com:6543/postgres

DATABASE_SSL=true
DATABASE_POOL_MAX=5
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
SUPABASE_STORAGE_BUCKET=uploads

# Browser-safe Supabase values. Do not place private server keys under VITE_.
VITE_SUPABASE_URL=https://[project-id].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# JWT secret used to sign admin session tokens — set a strong random value in production
JWT_SECRET=your-long-random-secret-min-32-chars

# Default admin account (created on first run if it doesn't already exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com
VITE_API_BASE_URL=